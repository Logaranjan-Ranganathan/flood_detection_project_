NODE_ENV=
# --- Database -------------------------------------------------------------
# Leave DATABASE_URL unset to use the bundled embedded PostgreSQL (PGlite)
# which stores data in ./data/pglite. Good for local development and demos.
# For production point this at a real PostgreSQL server and set the driver.
DATABASE_URL=
# `pglite` (default, embedded) or `postgres` (real server via DATABASE_URL)
DB_DRIVER=pglite
# DATABASE_POOL_MAX=10

# --- Secrets ----------------------------------------------------------------
# Admin sessions are opaque random tokens stored only as SHA-256 hashes, so no
# signing secret is required. Device tokens are generated in the admin console.

# --- Seeding ----------------------------------------------------------------
# Credentials for the initial admin account created by `npm run db:seed`.
# Required in production; only used for the first admin if none exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Ingestion --------------------------------------------------------------
DEMO_MODE=true
# When true the seeder creates clearly-labelled simulated readings.
